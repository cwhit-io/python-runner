{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vimeo",
  "description": "AI-callable wrapper for the Vimeo API. Manage videos, livestreams, and uploads.",
  "type": "object",
  "required": ["action"],
  "properties": {
    "action": {
      "type": "string",
      "description": "The action to perform.",
      "enum": [
        "list_recent_videos",
        "search_videos",
        "get_video",
        "find_recent_livestreams",
        "update_video_metadata",
        "prepare_upload"
      ]
    },
    "video_id": {
      "type": "string",
      "description": "Required for get_video and update_video_metadata. Vimeo video ID (numeric)."
    },
    "query": {
      "type": "string",
      "description": "Search query for search_videos."
    },
    "data": {
      "type": "object",
      "description": "Metadata body for update_video_metadata. Fields like name, description, privacy."
    },
    "upload_type": {
      "type": "string",
      "description": "Upload approach for prepare_upload (e.g. 'tus').",
      "default": "tus"
    },
    "file_size": {
      "type": "integer",
      "description": "File size in bytes for upload preparation.",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "description": "Video name for upload preparation."
    },
    "description": {
      "type": "string",
      "description": "Video description."
    },
    "privacy": {
      "type": "string",
      "description": "Privacy setting for upload: 'anybody', 'nobody', 'contacts', 'password', 'unlisted'.",
      "default": "anybody"
    },
    "dry_run": {
      "type": "boolean",
      "description": "When true, preview the request without sending.",
      "default": false
    },
    "per_page": { "type": "integer", "description": "Results per page.", "default": 25, "minimum": 1, "maximum": 100 },
    "page": { "type": "integer", "description": "Page number for pagination.", "minimum": 1 },
    "sort": { "type": "string", "description": "Sort order (date, name, plays, etc.)." },
    "direction": { "type": "string", "description": "Sort direction: 'asc' or 'desc'.", "enum": ["asc", "desc"] },
    "filter": { "type": "string", "description": "Filter for video list." },
    "fields": { "type": "string", "description": "Comma-separated field list for sparse response." },
    "timeout_seconds": { "type": "integer", "description": "Request timeout.", "default": 30, "minimum": 1, "maximum": 120 }
  },
  "examples": [
    { "action": "list_recent_videos", "per_page": 10 },
    { "action": "search_videos", "query": "sermon", "per_page": 5 },
    { "action": "get_video", "video_id": "123456789" },
    { "action": "find_recent_livestreams" },
    { "action": "update_video_metadata", "video_id": "123456789", "data": { "name": "Updated Title" }, "dry_run": true },
    { "action": "prepare_upload", "name": "New Video", "file_size": 104857600, "dry_run": true }
  ]
}
