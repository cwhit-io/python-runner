{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "planning_center_checkins",
  "description": "AI-callable wrapper for Planning Center Check-Ins API. Manage check-in events, locations, and attendees.",
  "type": "object",
  "required": ["action"],
  "properties": {
    "action": {
      "type": "string",
      "description": "The action to perform.",
      "enum": [
        "list_events",
        "get_event",
        "list_check_ins",
        "get_check_in",
        "list_locations",
        "list_event_periods",
        "list_attendees",
        "list_headcounts",
        "list_event_times",
        "list_passes",
        "list_options",
        "list_stations",
        "list_labels",
        "list_person_check_ins"
      ]
    },
    "event_id": {
      "type": "string",
      "description": "Required for get_event, list_event_periods, list_event_times. Optionally filters check_ins and attendees."
    },
    "person_id": {
      "type": "string",
      "description": "Required for list_person_check_ins."
    },
    "check_in_id": {
      "type": "string",
      "description": "Required for get_check_in."
    },
    "per_page": { "type": "integer", "description": "Results per page (max 100).", "default": 25, "minimum": 1, "maximum": 100 },
    "offset": { "type": "integer", "description": "Records to skip.", "minimum": 0 },
    "order": { "type": "string", "description": "Sort order." },
    "include": { "type": "string", "description": "Comma-separated related resources to include." },
    "where": { "type": "string", "description": "JSON filter conditions." },
    "filter": { "type": "string", "description": "Named API filter." },
    "fields": { "type": "string", "description": "Sparse fieldsets." },
    "timeout_seconds": { "type": "integer", "description": "Request timeout.", "default": 30, "minimum": 1, "maximum": 120 }
  },
  "examples": [
    { "action": "list_events", "per_page": 10 },
    { "action": "get_event", "event_id": "123" },
    { "action": "list_check_ins", "event_id": "123", "per_page": 20 },
    { "action": "list_locations" }
  ]
}
