{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "planning_center_giving",
  "description": "AI-callable wrapper for Planning Center Giving API. Read-only access to donations, funds, batches, and giving data.",
  "type": "object",
  "required": ["action"],
  "properties": {
    "action": {
      "type": "string",
      "description": "The action to perform.",
      "enum": [
        "list_donations",
        "get_donation",
        "list_funds",
        "list_batches",
        "list_designations",
        "list_recurring_donations",
        "list_refunds",
        "list_people",
        "list_person_donations",
        "list_campuses",
        "list_campus_donations",
        "list_in_kind_donations",
        "list_labels",
        "list_payment_sources"
      ]
    },
    "donation_id": {
      "type": "string",
      "description": "Required for get_donation. Optionally filters designations."
    },
    "person_id": {
      "type": "string",
      "description": "Required for list_person_donations."
    },
    "campus_id": {
      "type": "string",
      "description": "Required for list_campus_donations."
    },
    "per_page": { "type": "integer", "description": "Results per page (max 100).", "default": 25, "minimum": 1, "maximum": 100 },
    "offset": { "type": "integer", "description": "Records to skip.", "minimum": 0 },
    "order": { "type": "string", "description": "Sort order." },
    "include": { "type": "string", "description": "Comma-separated related resources to include." },
    "where": { "type": "string", "description": "JSON filter conditions." },
    "filter": { "type": "string", "description": "Named API filter." },
    "fields": { "type": "string", "description": "Sparse fieldsets." },
    "timeout_seconds": { "type": "integer", "description": "Request timeout.", "default": 30, "minimum": 1, "maximum": 120 }
  },
  "examples": [
    { "action": "list_donations", "per_page": 10 },
    { "action": "get_donation", "donation_id": "123456" },
    { "action": "list_funds" },
    { "action": "list_batches", "per_page": 5 }
  ]
}
