{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sermonshots",
  "description": "AI-callable wrapper for the SermonShots API. Manage videos, transcriptions, clips, media, and AI-generated sermon content. Matches the SermonShots OpenAPI 3.0 spec.",
  "type": "object",
  "required": ["action"],
  "properties": {
    "action": {
      "type": "string",
      "description": "The action to perform.",
      "enum": [
        "get_church_meta",
        "list_videos",
        "get_video",
        "create_video_from_url",
        "create_video_from_stream",
        "get_transcript",
        "list_clips",
        "get_images",
        "get_downloadable",
        "get_all_content",
        "get_summary",
        "get_blog_post",
        "get_devotionals",
        "get_discussion_guide",
        "get_quotes",
        "get_titles"
      ]
    },
    "church_name": {
      "type": "string",
      "description": "Required for get_church_meta. Church slug (e.g. 'first-baptist')."
    },
    "video_id": {
      "type": "string",
      "description": "Required for video, transcript, clip, media, and content actions."
    },
    "image_type": {
      "type": "string",
      "description": "Required for get_images. Image type (e.g. 'thumbnail', 'quote')."
    },
    "downloadable_type": {
      "type": "string",
      "description": "Required for get_downloadable. Downloadable type (e.g. 'clips', 'quote', 'thumbnail')."
    },
    "source": {
      "type": "string",
      "description": "Required for create_video_from_stream. Streaming source type.",
      "enum": ["hls", "dash"]
    },
    "public_url": {
      "type": "string",
      "format": "uri",
      "description": "Required for create_video_from_url and create_video_from_stream. Public URL of the video to process."
    },
    "language": {
      "type": "string",
      "description": "Required for create_video_from_url and create_video_from_stream.",
      "enum": ["english", "dutch", "french", "finnish", "german", "portuguese", "russian", "spanish", "turkish"]
    },
    "filename": {
      "type": "string",
      "description": "Required for create_video_from_url and create_video_from_stream. Desired filename for the uploaded video."
    },
    "reencode": {
      "type": "boolean",
      "description": "Whether to re-encode the video (default: false per spec).",
      "default": false
    },
    "start": {
      "type": "number",
      "description": "Optional start time in seconds for partial video processing."
    },
    "end": {
      "type": "number",
      "description": "Optional end time in seconds for partial video processing."
    },
    "with_projects": {
      "type": "boolean",
      "description": "For get_downloadable. Include projects in the response."
    },
    "dry_run": {
      "type": "boolean",
      "description": "When true, preview the request without sending (upload actions only).",
      "default": false
    },
    "page": { "type": "integer", "description": "Page number for pagination.", "minimum": 1 },
    "limit": { "type": "integer", "description": "Results per page (matches spec).", "default": 25, "minimum": 1, "maximum": 100 },
    "sort_by": {
      "type": "string",
      "description": "Field to sort by for list_videos (default: createdAt).",
      "enum": ["createdAt", "updatedAt", "name"],
      "default": "createdAt"
    },
    "direction": {
      "type": "string",
      "description": "Sort direction for list_videos.",
      "enum": ["DESC", "ASC", "desc", "asc"]
    },
    "sort": {
      "type": "string",
      "description": "Alias for direction on list_videos when set to DESC/ASC. Prefer direction + sort_by."
    },
    "timeout_seconds": { "type": "integer", "description": "Request timeout in seconds.", "default": 30, "minimum": 1, "maximum": 120 }
  },
  "examples": [
    { "action": "get_church_meta", "church_name": "first-baptist" },
    { "action": "list_videos", "limit": 10 },
    { "action": "list_videos", "page": 1, "limit": 10, "sort": "DESC" },
    { "action": "list_videos", "page": 1, "limit": 10, "sort_by": "createdAt", "direction": "DESC" },
    { "action": "get_video", "video_id": "123" },
    { "action": "create_video_from_url", "public_url": "https://example.com/sermon.mp4", "language": "english", "filename": "sunday-sermon", "dry_run": true },
    { "action": "create_video_from_stream", "source": "hls", "public_url": "https://example.com/stream.m3u8", "language": "english", "filename": "stream-sermon", "dry_run": true },
    { "action": "get_transcript", "video_id": "123" },
    { "action": "list_clips", "video_id": "123" },
    { "action": "get_images", "video_id": "123", "image_type": "thumbnail" },
    { "action": "get_downloadable", "video_id": "123", "downloadable_type": "clips", "with_projects": true },
    { "action": "get_all_content", "video_id": "123" },
    { "action": "get_summary", "video_id": "123" },
    { "action": "get_blog_post", "video_id": "123" },
    { "action": "get_devotionals", "video_id": "123" },
    { "action": "get_discussion_guide", "video_id": "123" },
    { "action": "get_quotes", "video_id": "123" },
    { "action": "get_titles", "video_id": "123" }
  ]
}