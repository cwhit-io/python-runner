{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sermonshots",
  "description": "AI-callable wrapper for the SermonShots API. Manage videos, clips, transcripts, and AI-generated sermon content (summaries, blog posts, devotionals, discussion guides).",
  "type": "object",
  "required": ["action"],
  "properties": {
    "action": {
      "type": "string",
      "description": "The action to perform.",
      "enum": [
        "list_videos",
        "get_video",
        "create_video_from_url",
        "upload_video_metadata",
        "get_transcript",
        "list_clips",
        "get_clip",
        "list_generated_content",
        "get_summary",
        "get_blog_post",
        "get_devotional",
        "get_discussion_guide"
      ]
    },
    "video_id": {
      "type": "string",
      "description": "Required for get_video, upload_video_metadata, get_transcript, get_summary, get_blog_post, get_devotional, get_discussion_guide. Optionally filters clips and generated_content."
    },
    "clip_id": {
      "type": "string",
      "description": "Required for get_clip."
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Public video URL for create_video_from_url action."
    },
    "title": {
      "type": "string",
      "description": "Video title for create_video_from_url."
    },
    "publish_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO datetime for scheduled publishing."
    },
    "metadata": {
      "type": "object",
      "description": "Metadata object for upload_video_metadata. Custom key-value pairs for video enrichment."
    },
    "dry_run": {
      "type": "boolean",
      "description": "When true, preview the request without sending.",
      "default": false
    },
    "per_page": { "type": "integer", "description": "Results per page.", "default": 25, "minimum": 1, "maximum": 100 },
    "page": { "type": "integer", "description": "Page number.", "minimum": 1 },
    "sort": { "type": "string", "description": "Sort field." },
    "direction": { "type": "string", "description": "Sort direction.", "enum": ["asc", "desc"] },
    "status": { "type": "string", "description": "Filter by status (e.g. 'completed', 'processing', 'failed')." },
    "query": { "type": "string", "description": "Search query." },
    "timeout_seconds": { "type": "integer", "description": "Request timeout.", "default": 30, "minimum": 1, "maximum": 120 }
  },
  "examples": [
    { "action": "list_videos", "per_page": 10 },
    { "action": "get_video", "video_id": "123" },
    { "action": "create_video_from_url", "url": "https://example.com/sermon.mp4", "title": "Sunday Sermon", "dry_run": true },
    { "action": "get_transcript", "video_id": "123" },
    { "action": "get_summary", "video_id": "123" },
    { "action": "get_blog_post", "video_id": "123" }
  ]
}
