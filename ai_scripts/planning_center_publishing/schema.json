{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "planning_center_publishing",
  "description": "AI-callable wrapper for Planning Center Publishing API. Manage episodes, series, and speakers.",
  "type": "object",
  "required": ["action"],
  "properties": {
    "action": {
      "type": "string",
      "description": "The action to perform.",
      "enum": [
        "list_episodes",
        "get_episode",
        "list_series",
        "get_series",
        "list_speakers",
        "list_episode_resources",
        "create_episode",
        "update_episode"
      ]
    },
    "episode_id": {
      "type": "string",
      "description": "Required for get_episode, list_episode_resources, and update_episode."
    },
    "series_id": {
      "type": "string",
      "description": "Required for get_series."
    },
    "data": {
      "type": "object",
      "description": "Request body for create_episode and update_episode. JSON:API resource object."
    },
    "dry_run": {
      "type": "boolean",
      "description": "When true, preview the request without sending.",
      "default": false
    },
    "per_page": { "type": "integer", "description": "Results per page (max 100).", "default": 25, "minimum": 1, "maximum": 100 },
    "offset": { "type": "integer", "description": "Records to skip.", "minimum": 0 },
    "order": { "type": "string", "description": "Sort order." },
    "include": { "type": "string", "description": "Comma-separated related resources to include." },
    "where": { "type": "string", "description": "JSON filter conditions." },
    "filter": { "type": "string", "description": "Named API filter." },
    "fields": { "type": "string", "description": "Sparse fieldsets." },
    "timeout_seconds": { "type": "integer", "description": "Request timeout.", "default": 30, "minimum": 1, "maximum": 120 }
  },
  "examples": [
    { "action": "list_episodes", "per_page": 10 },
    { "action": "get_episode", "episode_id": "123", "include": "resources" },
    { "action": "list_series" },
    { "action": "create_episode", "data": { "data": { "type": "Episode", "attributes": { "title": "New Episode" } } }, "dry_run": true }
  ]
}
