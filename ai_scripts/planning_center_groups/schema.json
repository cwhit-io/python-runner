{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "planning_center_groups",
  "description": "AI-callable wrapper for Planning Center Groups API. Manage groups, memberships, and group events.",
  "type": "object",
  "required": ["action"],
  "properties": {
    "action": {
      "type": "string",
      "description": "The action to perform.",
      "enum": [
        "list_groups",
        "search_groups",
        "get_group",
        "list_group_memberships",
        "list_group_events",
        "list_group_types",
        "list_people",
        "create_group_event"
      ]
    },
    "group_id": {
      "type": "string",
      "description": "Required for get_group, list_group_memberships, list_group_events, and create_group_event."
    },
    "query": {
      "type": "string",
      "description": "Search query for search_groups."
    },
    "data": {
      "type": "object",
      "description": "Request body for write actions. JSON:API resource object."
    },
    "dry_run": {
      "type": "boolean",
      "description": "When true, preview the request without sending.",
      "default": false
    },
    "per_page": { "type": "integer", "description": "Results per page (max 100).", "default": 25, "minimum": 1, "maximum": 100 },
    "offset": { "type": "integer", "description": "Records to skip.", "minimum": 0 },
    "order": { "type": "string", "description": "Sort order." },
    "include": { "type": "string", "description": "Comma-separated related resources to include." },
    "where": { "type": "string", "description": "JSON filter conditions." },
    "filter": { "type": "string", "description": "Named API filter." },
    "fields": { "type": "string", "description": "Sparse fieldsets." },
    "timeout_seconds": { "type": "integer", "description": "Request timeout.", "default": 30, "minimum": 1, "maximum": 120 }
  },
  "examples": [
    { "action": "list_groups", "per_page": 10 },
    { "action": "search_groups", "query": "Youth" },
    { "action": "get_group", "group_id": "123", "include": "memberships" },
    { "action": "create_group_event", "group_id": "123", "data": { "data": { "type": "Event", "attributes": { "name": "Game Night" } } }, "dry_run": true }
  ]
}
