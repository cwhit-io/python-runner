{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "planning_center_services",
  "description": "AI-callable wrapper for Planning Center Services API. Manage service types, plans, songs, teams, and plan items.",
  "type": "object",
  "required": ["action"],
  "properties": {
    "action": {
      "type": "string",
      "description": "The action to perform.",
      "enum": [
        "list_service_types",
        "list_plans",
        "get_plan",
        "list_plan_items",
        "list_plan_people",
        "list_songs",
        "search_songs",
        "list_teams",
        "list_people",
        "list_media",
        "list_series",
        "list_email_templates",
        "list_attachment_types",
        "list_plan_notes",
        "list_plan_attachments",
        "list_team_people",
        "update_plan_title",
        "create_plan_note"
      ]
    },
    "service_type_id": {
      "type": "string",
      "description": "Service type ID to scope plans list."
    },
    "plan_id": {
      "type": "string",
      "description": "Required for get_plan, list_plan_items, list_plan_people, list_plan_notes, list_plan_attachments, update_plan_title, create_plan_note."
    },
    "team_id": {
      "type": "string",
      "description": "Required for list_team_people."
    },
    "title": {
      "type": "string",
      "description": "New title for update_plan_title action."
    },
    "content": {
      "type": "string",
      "description": "Note content for create_plan_note action."
    },
    "category": {
      "type": "string",
      "description": "Note category for create_plan_note action (e.g. 'notes', 'prayer', ' announcements')."
    },
    "query": {
      "type": "string",
      "description": "Search query for search_songs."
    },
    "data": {
      "type": "object",
      "description": "Generic request body for custom writes."
    },
    "dry_run": {
      "type": "boolean",
      "description": "When true, preview the request without sending.",
      "default": false
    },
    "per_page": { "type": "integer", "description": "Results per page (max 100).", "default": 25, "minimum": 1, "maximum": 100 },
    "offset": { "type": "integer", "description": "Records to skip.", "minimum": 0 },
    "order": { "type": "string", "description": "Sort order." },
    "include": { "type": "string", "description": "Comma-separated related resources to include." },
    "where": { "type": "string", "description": "JSON filter conditions." },
    "filter": { "type": "string", "description": "Named API filter." },
    "fields": { "type": "string", "description": "Sparse fieldsets." },
    "timeout_seconds": { "type": "integer", "description": "Request timeout.", "default": 30, "minimum": 1, "maximum": 120 }
  },
  "examples": [
    { "action": "list_service_types" },
    { "action": "list_plans", "service_type_id": "123", "per_page": 10 },
    { "action": "get_plan", "plan_id": "456", "include": "items,team_members" },
    { "action": "update_plan_title", "plan_id": "456", "title": "Sunday Morning - Updated", "dry_run": true },
    { "action": "create_plan_note", "plan_id": "456", "content": "Sound check at 8:00 AM", "dry_run": true }
  ]
}
