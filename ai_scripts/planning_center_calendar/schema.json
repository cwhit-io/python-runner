{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "planning_center_calendar",
  "description": "AI-callable wrapper for Planning Center Calendar API. Manage events, resources, rooms, and tags.",
  "type": "object",
  "required": ["action"],
  "properties": {
    "action": {
      "type": "string",
      "description": "The action to perform.",
      "enum": [
        "list_events",
        "search_events",
        "get_event",
        "list_event_instances",
        "list_resources",
        "list_rooms",
        "list_tags",
        "create_event",
        "update_event"
      ]
    },
    "event_id": {
      "type": "string",
      "description": "Required for get_event, list_event_instances, and update_event."
    },
    "query": {
      "type": "string",
      "description": "Search query for search_events."
    },
    "data": {
      "type": "object",
      "description": "Request body for create_event and update_event. JSON:API resource object. Example: {\"data\": {\"type\": \"Event\", \"attributes\": {\"name\": \"Youth Group\", \"description\": \"Weekly youth gathering\"}}}"
    },
    "dry_run": {
      "type": "boolean",
      "description": "When true, preview the request without sending it.",
      "default": false
    },
    "per_page": { "type": "integer", "description": "Results per page (max 100).", "default": 25, "minimum": 1, "maximum": 100 },
    "offset": { "type": "integer", "description": "Records to skip.", "minimum": 0 },
    "order": { "type": "string", "description": "Sort order, e.g. 'name' or '-created_at'." },
    "include": { "type": "string", "description": "Comma-separated related resources to include." },
    "where": { "type": "string", "description": "JSON filter conditions." },
    "filter": { "type": "string", "description": "Named API filter." },
    "fields": { "type": "string", "description": "Sparse fieldsets." },
    "timeout_seconds": { "type": "integer", "description": "Request timeout.", "default": 30, "minimum": 1, "maximum": 120 }
  },
  "examples": [
    { "action": "list_events", "per_page": 10 },
    { "action": "get_event", "event_id": "123456", "include": "event_times" },
    { "action": "create_event", "data": { "data": { "type": "Event", "attributes": { "name": "Test Event" } } }, "dry_run": true }
  ]
}
