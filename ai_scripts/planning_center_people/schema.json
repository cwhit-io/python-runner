{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "planning_center_people",
  "description": "AI-callable wrapper for Planning Center People API. Manage individuals, households, campuses, workflows, and lists.",
  "type": "object",
  "required": ["action"],
  "properties": {
    "action": {
      "type": "string",
      "description": "The action to perform.",
      "enum": [
        "list_people",
        "search_people",
        "get_person",
        "list_households",
        "get_household",
        "list_campuses",
        "list_workflows",
        "list_lists",
        "get_list",
        "list_birthdays",
        "create_person",
        "update_person"
      ]
    },
    "person_id": {
      "type": "string",
      "description": "Required for get_person and update_person. The Planning Center person ID."
    },
    "household_id": {
      "type": "string",
      "description": "Required for get_household. The Planning Center household ID."
    },
    "list_id": {
      "type": "string",
      "description": "Required for get_list. The Planning Center list ID."
    },
    "query": {
      "type": "string",
      "description": "Search query for search_people action."
    },
    "month": {
      "type": "integer",
      "description": "Month (1-12) for list_birthdays action.",
      "minimum": 1,
      "maximum": 12
    },
    "day": {
      "type": "integer",
      "description": "Day (1-31) for list_birthdays action.",
      "minimum": 1,
      "maximum": 31
    },
    "data": {
      "type": "object",
      "description": "Request body for create_person and update_person. Should be a JSON:API resource object with 'data' wrapper. Example: {\"data\": {\"type\": \"Person\", \"attributes\": {\"first_name\": \"John\", \"last_name\": \"Doe\"}}}"
    },
    "dry_run": {
      "type": "boolean",
      "description": "When true, preview the request without sending it. Only applies to create/update actions.",
      "default": false
    },
    "per_page": {
      "type": "integer",
      "description": "Number of results per page (max 100).",
      "default": 25,
      "minimum": 1,
      "maximum": 100
    },
    "offset": {
      "type": "integer",
      "description": "Number of records to skip for pagination.",
      "minimum": 0
    },
    "order": {
      "type": "string",
      "description": "Sort order, e.g. 'last_name' or '-created_at'."
    },
    "include": {
      "type": "string",
      "description": "Comma-separated related resources to include, e.g. 'addresses,emails'."
    },
    "where": {
      "type": "string",
      "description": "JSON string of filter conditions for JSON:API filtering."
    },
    "filter": {
      "type": "string",
      "description": "Named filter from Planning Center API."
    },
    "fields": {
      "type": "string",
      "description": "Sparse fieldsets, e.g. 'first_name,last_name'."
    },
    "timeout_seconds": {
      "type": "integer",
      "description": "Request timeout in seconds.",
      "default": 30,
      "minimum": 1,
      "maximum": 120
    }
  },
  "examples": [
    {
      "action": "list_people",
      "per_page": 10
    },
    {
      "action": "search_people",
      "query": "John Doe"
    },
    {
      "action": "get_person",
      "person_id": "123456",
      "include": "addresses,emails,phone_numbers"
    },
    {
      "action": "create_person",
      "data": {
        "data": {
          "type": "Person",
          "attributes": {
            "first_name": "Jane",
            "last_name": "Smith"
          }
        }
      },
      "dry_run": true
    }
  ]
}
