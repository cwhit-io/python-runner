DEBUG=1
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=your-secure-password-here

# PostgreSQL Configuration (uncomment for production)
# DATABASE_URL=postgresql://user:password@host:5432/database

# Or use individual variables:
# POSTGRES_DB=scriptdash
# POSTGRES_USER=scriptdash
# POSTGRES_PASSWORD=your-secure-password
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432

# Timezone defaults to America/New_York in Django settings